<?xml version="1.0" encoding="utf-8"?>
<!-- Azalon game card: blurred cover wash, rounded icon, platform badge, two-line title. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_game"
    style="?attr/materialCardViewOutlinedStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:stateListAnimator="@animator/azalon_card_press"
    app:cardCornerRadius="20dp"
    tools:layout_width="170dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_contents"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/image_game_backdrop"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0.55"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="H,1:0.82"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/view_art_scrim"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/azalon_art_scrim"
            app:layout_constraintBottom_toBottomOf="@id/image_game_backdrop"
            app:layout_constraintEnd_toEndOf="@id/image_game_backdrop"
            app:layout_constraintStart_toStartOf="@id/image_game_backdrop"
            app:layout_constraintTop_toTopOf="@id/image_game_backdrop" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image_game_screen"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginTop="6dp"
            android:elevation="6dp"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@id/image_game_backdrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/image_game_backdrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Azalon.GameIcon" />

        <TextView
            android:id="@+id/text_platform_badge"
            style="@style/TextAppearance.Azalon.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@drawable/azalon_badge_background"
            android:paddingStart="9dp"
            android:paddingTop="2dp"
            android:paddingEnd="9dp"
            android:paddingBottom="2dp"
            android:textColor="@color/azalon_badge_3ds"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="3DS" />

        <ImageView
            android:id="@+id/image_cartridge"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_margin="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/cartridge"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_game_title"
            style="@style/TextAppearance.Azalon.CardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:minLines="2"
            android:textAlignment="viewStart"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/image_game_backdrop"
            tools:text="The Legend of Zelda: Ocarina of Time 3D" />

        <TextView
            android:id="@+id/text_company"
            style="@style/TextAppearance.Material3.BodySmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="none"
            android:marqueeRepeatLimit="marquee_forever"
            android:requiresFadingEdge="horizontal"
            android:singleLine="true"
            android:textAlignment="viewStart"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_game_title"
            tools:text="Nintendo" />

        <TextView
            android:id="@+id/text_game_region"
            style="@style/TextAppearance.Material3.LabelSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:ellipsize="none"
            android:marqueeRepeatLimit="marquee_forever"
            android:requiresFadingEdge="horizontal"
            android:singleLine="true"
            android:textAlignment="viewStart"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_company"
            app:layout_goneMarginTop="2dp"
            tools:text="North America" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<!-- Azalon Teal theme. Selected as "Theme Color" index 0 (see ThemeUtil); forces dark mode. -->
<resources>

    <style name="Theme.Citra.Azalon" parent="Theme.Citra">
        <item name="colorPrimary">@color/azalon_accent</item>
        <item name="colorOnPrimary">@color/azalon_on_accent</item>
        <item name="colorPrimaryContainer">@color/azalon_accent_container</item>
        <item name="colorOnPrimaryContainer">@color/azalon_on_accent_container</item>
        <item name="colorSecondary">@color/azalon_accent2</item>
        <item name="colorOnSecondary">@color/azalon_on_accent</item>
        <item name="colorSecondaryContainer">#12352B</item>
        <item name="colorOnSecondaryContainer">#C8F7DA</item>
        <item name="colorTertiary">@color/azalon_badge_ds</item>
        <item name="colorOnTertiary">#04162E</item>
        <item name="colorTertiaryContainer">#1B2F4A</item>
        <item name="colorOnTertiaryContainer">#D6E6FF</item>
        <item name="android:colorBackground">@color/azalon_window</item>
        <item name="colorOnBackground">@color/azalon_text</item>
        <item name="colorSurface">@color/azalon_window</item>
        <item name="colorOnSurface">@color/azalon_text</item>
        <item name="colorSurfaceVariant">@color/azalon_surface_raised</item>
        <item name="colorOnSurfaceVariant">@color/azalon_text_muted</item>
        <item name="colorOutline">#3A504C</item>
        <item name="colorOnSurfaceInverse">@color/azalon_window</item>
        <item name="colorSurfaceInverse">@color/azalon_text</item>
        <item name="colorPrimaryInverse">@color/azalon_accent_pressed</item>
        <item name="colorError">@color/azalon_error</item>
        <item name="colorOnError">@color/azalon_on_error</item>
        <item name="android:windowBackground">@color/azalon_window</item>
        <item name="elevationOverlayEnabled">false</item>

        <!-- Rounder, softer shapes everywhere -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Azalon.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Azalon.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Azalon.Large</item>

        <!-- Components -->
        <item name="materialCardViewStyle">@style/Widget.Azalon.Card</item>
        <item name="materialCardViewOutlinedStyle">@style/Widget.Azalon.Card</item>
        <item name="materialCardViewElevatedStyle">@style/Widget.Azalon.Card</item>
        <item name="materialCardViewFilledStyle">@style/Widget.Azalon.Card</item>
        <item name="bottomNavigationStyle">@style/Widget.Azalon.BottomNavigation</item>
        <item name="navigationRailStyle">@style/Widget.Azalon.NavigationRail</item>
        <item name="navigationViewStyle">@style/Widget.Azalon.NavigationView</item>
        <item name="floatingActionButtonStyle">@style/Widget.Azalon.FloatingActionButton</item>
        <item name="extendedFloatingActionButtonStyle">@style/Widget.Azalon.ExtendedFloatingActionButton</item>
        <item name="materialButtonStyle">@style/Widget.Azalon.Button</item>
        <item name="chipStyle">@style/Widget.Azalon.Chip</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Azalon.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Azalon.BottomSheet</item>
        <item name="android:popupMenuStyle">@style/Widget.Azalon.PopupMenu</item>
        <item name="popupMenuStyle">@style/Widget.Azalon.PopupMenu</item>
        <item name="sliderStyle">@style/Widget.Azalon.Slider</item>
    </style>

    <!-- Shapes -->
    <style name="ShapeAppearance.Azalon.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Azalon.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.Azalon.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearance.Azalon.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.Azalon.TopSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ShapeAppearance.Azalon.GameIcon" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <!-- Cards: translucent glass with a hairline highlight -->
    <style name="Widget.Azalon.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/azalon_surface_container</item>
        <item name="strokeColor">@color/azalon_card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Azalon.Medium</item>
        <item name="rippleColor">@color/azalon_accent_glow</item>
    </style>

    <!-- Navigation -->
    <style name="Widget.Azalon.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/azalon_nav_background</item>
        <item name="backgroundTint">@null</item>
        <item name="elevation">0dp</item>
        <item name="itemIconTint">@color/azalon_nav_item</item>
        <item name="itemTextColor">@color/azalon_nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Azalon.NavigationActiveIndicator</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Azalon.NavLabel</item>
        <item name="itemRippleColor">@color/azalon_accent_glow</item>
    </style>

    <style name="Widget.Azalon.NavigationRail" parent="Widget.Material3.NavigationRailView">
        <item name="android:background">@drawable/azalon_rail_background</item>
        <item name="backgroundTint">@null</item>
        <item name="elevation">0dp</item>
        <item name="itemIconTint">@color/azalon_nav_item</item>
        <item name="itemTextColor">@color/azalon_nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Azalon.RailActiveIndicator</item>
        <item name="itemRippleColor">@color/azalon_accent_glow</item>
    </style>

    <style name="Widget.Azalon.RailActiveIndicator" parent="Widget.Material3.NavigationRailView.ActiveIndicator">
        <item name="android:color">@color/azalon_accent_container</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Azalon.Pill</item>
    </style>

    <style name="Widget.Azalon.NavigationActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/azalon_accent_container</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Azalon.Pill</item>
    </style>

    <style name="TextAppearance.Azalon.NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- In-game drawer -->
    <style name="Widget.Azalon.NavigationView" parent="Widget.Material3.NavigationView">
        <item name="android:background">@color/azalon_surface</item>
        <item name="backgroundTint">@null</item>
        <item name="itemIconTint">@color/azalon_drawer_item</item>
        <item name="itemTextColor">@color/azalon_drawer_item</item>
        <item name="itemShapeFillColor">@color/azalon_drawer_item_fill</item>
        <item name="itemShapeAppearance">@style/ShapeAppearance.Azalon.Pill</item>
        <item name="itemShapeInsetStart">12dp</item>
        <item name="itemShapeInsetEnd">12dp</item>
    </style>

    <!-- Buttons / FABs / chips -->
    <style name="Widget.Azalon.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.Azalon.Pill</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Azalon.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="shapeAppearance">@style/ShapeAppearance.Azalon.Medium</item>
        <item name="backgroundTint">@color/azalon_accent</item>
        <item name="tint">@color/azalon_on_accent</item>
    </style>

    <style name="Widget.Azalon.ExtendedFloatingActionButton" parent="Widget.Material3.ExtendedFloatingActionButton.Primary">
        <item name="shapeAppearance">@style/ShapeAppearance.Azalon.Pill</item>
        <item name="backgroundTint">@color/azalon_accent</item>
        <item name="android:textColor">@color/azalon_on_accent</item>
        <item name="iconTint">@color/azalon_on_accent</item>
    </style>

    <style name="Widget.Azalon.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/azalon_chip_background</item>
        <item name="chipStrokeColor">@color/azalon_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/azalon_chip_text</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Azalon.Pill</item>
        <item name="android:textAppearance">@style/TextAppearance.Azalon.Chip</item>
        <item name="chipMinHeight">36dp</item>
        <item name="rippleColor">@color/azalon_accent_glow</item>
    </style>

    <style name="TextAppearance.Azalon.Chip" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Azalon.Slider" parent="CitraSlider">
        <item name="trackColorActive">@color/azalon_accent</item>
        <item name="trackColorInactive">@color/azalon_surface_hover</item>
        <item name="thumbColor">@color/azalon_text</item>
        <item name="haloColor">@color/azalon_accent_glow</item>
    </style>

    <style name="Widget.Azalon.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/azalon_popup_background</item>
    </style>

    <!-- Dialogs and sheets -->
    <style name="ThemeOverlay.Azalon.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/azalon_surface_raised</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Azalon.Large</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Azalon.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Azalon.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Azalon.DialogButton</item>
    </style>

    <style name="Widget.Azalon.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/azalon_accent_light</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ThemeOverlay.Azalon.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Azalon.BottomSheet</item>
    </style>

    <style name="Widget.Azalon.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/azalon_surface_container</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Azalon.TopSheet</item>
    </style>

    <!-- Home screen text -->
    <style name="TextAppearance.Azalon.Brand" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/azalon_text</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.Azalon.CardTitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Azalon.Badge" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>

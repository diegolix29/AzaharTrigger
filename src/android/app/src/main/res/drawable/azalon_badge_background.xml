<?xml version="1.0" encoding="utf-8"?>
<!-- Platform badge on game cards; the stroke color is re-tinted per platform in GameAdapter. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="999dp" />
    <solid android:color="@color/azalon_badge_background" />
    <stroke android:width="1dp" android:color="@color/azalon_badge_3ds" />
</shape>
